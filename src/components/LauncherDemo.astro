---
/*
 * Events Client, rebuilt with its own tokens and strings, doing the one thing
 * that defines it: a code goes in, the instance syncs, "Jugar" appears.
 *
 * Without JS (or with reduced motion) it shows the finished state. The home
 * page script plays the sequence once when it comes into view.
 * The event shown is the next real one from Events Calendar.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { eventWhen, type LiveEvent } from '../data/live';

interface Props { event: LiveEvent | null }
const { event } = Astro.props;
const name = event?.name ?? 'Tu próximo evento';
const studio = event?.studio || 'Tu studio';
const when = event ? eventWhen(event.startsAt) : 'Sábado · 22:00';
const tone = event?.color || '#7b5cff';
const CODE = 'K7QX-29PL-EV4M'; // demo code, format XXXX-XXXX-XXXX
const initial = name.trim().charAt(0).toUpperCase();
---
<figure class="ld" style={`--tone:${tone}`} data-ld>
    <figcaption class="sr-only">
        Events Client: se introduce un código de acceso, la instancia del evento «{name}» se sincroniza y aparece el botón Jugar.
    </figcaption>
    <div class="ld-win" aria-hidden="true" inert>
        <div class="ld-top">
            <span class="ld-title"><Logo size={16} /> Events <b>Client</b></span>
            <span class="ld-ver">1.0.2</span>
            <span class="ld-winbtns"><i></i><i></i><i></i></span>
        </div>
        <div class="ld-body">
            <nav class="ld-rail">
                <span class="ld-nav on"><Icon name="home" size={18} /></span>
                <span class="ld-nav"><Icon name="compass" size={18} /></span>
                <span class="ld-sep"></span>
                <span class="ld-tile" data-ld-tile>
                    {event?.image ? <img src={event.image} alt="" loading="lazy" decoding="async" data-ld-img /> : <b>{initial}</b>}
                </span>
                <span class="ld-tile add"><Icon name="plus" size={18} /></span>
            </nav>

            <div class="ld-stage">
                <!-- Instance view (final state by default) -->
                <section class="ld-inst" data-ld-inst>
                    <div class="ld-art">
                        {event?.image && <img src={event.image} alt="" loading="lazy" decoding="async" data-ld-img />}
                    </div>
                    <div class="ld-inst-copy">
                        <span class="ld-studio" data-ld-studio>{studio}</span>
                        <span class="ld-name" data-ld-name>{name}</span>
                        <span class="ld-meta"><Icon name="clock" size={14} /> <span data-ld-when>{when}</span></span>
                        <div class="ld-action">
                            <div class="ld-sync" data-ld-sync>
                                <span class="ld-sync-label">Sincronizando recursos de la instancia</span>
                                <span class="ld-bar"><i data-ld-bar></i></span>
                                <span class="ld-sync-n tnum"><span data-ld-count>212</span> / 212 archivos</span>
                            </div>
                            <span class="ld-play" data-ld-play><Icon name="gamepad" size={20} /> Jugar</span>
                        </div>
                    </div>
                </section>

                <!-- Redeem dialog -->
                <section class="ld-redeem" data-ld-redeem>
                    <div class="ld-card">
                        <span class="ld-card-ic"><Icon name="key" size={22} /></span>
                        <span class="ld-card-t">Añadir instancia</span>
                        <span class="ld-card-s">Introduce el código de acceso de la instancia.</span>
                        <span class="ld-label">Código de acceso</span>
                        <span class="ld-code" data-ld-code>
                            {CODE.split('').map((c) => <span class={c === '-' ? 'dash' : 'ch'}>{c}</span>)}<i class="ld-caret"></i>
                        </span>
                        <span class="ld-redeem-btn" data-ld-btn>Canjear código</span>
                    </div>
                </section>

                <div class="ld-toast" data-ld-toast><Icon name="check" size={16} /> Instancia añadida</div>
            </div>
        </div>
    </div>
</figure>
<script is:inline>
    // Start from "before the code" only when the sequence will actually play.
    (function () {
        var f = document.currentScript && document.currentScript.previousElementSibling;
        if (f && !matchMedia('(prefers-reduced-motion: reduce)').matches) f.setAttribute('data-state', 'pre');
    })();
</script>

<style>
    .ld { position: relative; margin: 0; container-type: inline-size; }
    .ld-win {
        position: relative; aspect-ratio: 16 / 10.4; border-radius: 18px; overflow: hidden;
        background:
            radial-gradient(70% 60% at 0% 0%, rgba(91, 140, 255, 0.16), transparent 60%),
            radial-gradient(60% 60% at 100% 100%, rgba(124, 58, 237, 0.14), transparent 60%),
            #070a12;
        box-shadow: 0 0 0 1px rgba(170, 182, 255, 0.14), 0 2px 0 0 rgba(255, 255, 255, 0.04) inset, var(--shadow-4), 0 0 120px -30px rgba(107, 60, 255, 0.45);
        font-family: 'Poppins', var(--font-sans);
        color: #f4f7fd;
        user-select: none;
    }
    .ld-top {
        height: 9%; min-height: 26px; display: flex; align-items: center; gap: 8px; padding-inline: 3%;
        background: linear-gradient(180deg, rgba(7, 10, 18, 0.85), rgba(7, 10, 18, 0.35));
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        font-size: clamp(9px, 1.9cqi, 13px);
    }
    .ld-title { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; letter-spacing: -0.01em; }
    .ld-title b { color: #5b8cff; font-weight: 700; }
    .ld-ver { font-family: var(--font-mono); font-size: 0.8em; color: #6b7691; padding: 1px 6px; border: 1px solid rgba(255,255,255,.1); border-radius: 99px; }
    .ld-winbtns { margin-left: auto; display: inline-flex; gap: 14px; }
    .ld-winbtns i { width: 9px; height: 1.5px; background: #6b7691; border-radius: 2px; }
    .ld-winbtns i:nth-child(2) { height: 8px; background: none; border: 1.5px solid #6b7691; border-radius: 2px; }
    .ld-winbtns i:nth-child(3) { position: relative; background: none; }
    .ld-winbtns i:nth-child(3)::before, .ld-winbtns i:nth-child(3)::after { content: ''; position: absolute; inset: 0; background: #6b7691; transform: rotate(45deg); }
    .ld-winbtns i:nth-child(3)::after { transform: rotate(-45deg); }

    .ld-body { position: absolute; inset: 9% 0 0 0; display: flex; }
    .ld-rail {
        width: 11%; min-width: 46px; display: flex; flex-direction: column; align-items: center; gap: 4.5cqi; padding-top: 3cqi;
        background: rgba(18, 24, 38, 0.62); border-right: 1px solid rgba(255, 255, 255, 0.07);
    }
    .ld-nav { display: grid; place-items: center; width: 6.6cqi; height: 6.6cqi; min-width: 30px; min-height: 30px; border-radius: 1.8cqi; color: #9aa7c2; }
    .ld-nav.on { background: #5b8cff; color: #fff; box-shadow: 0 6px 18px rgba(91, 140, 255, 0.45); }
    .ld-sep { width: 40%; height: 1px; background: rgba(255, 255, 255, 0.08); }
    .ld-tile {
        position: relative; display: grid; place-items: center; overflow: hidden;
        width: 7cqi; height: 7cqi; min-width: 32px; min-height: 32px; border-radius: 2cqi;
        background: color-mix(in oklab, var(--tone) 42%, #0b1020);
        box-shadow: 0 0 0 2px var(--tone), 0 6px 18px -4px color-mix(in oklab, var(--tone) 60%, transparent);
        font-weight: 800; font-size: 3cqi;
    }
    .ld-tile img { width: 100%; height: 100%; object-fit: cover; }
    .ld-tile.add { background: none; box-shadow: none; border: 1.5px dashed rgba(255, 255, 255, 0.18); color: #9aa7c2; }

    .ld-stage { position: relative; flex: 1; overflow: hidden; }
    .ld-inst { position: absolute; inset: 0; }
    .ld-art { position: absolute; inset: 0; background: radial-gradient(80% 90% at 80% 20%, color-mix(in oklab, var(--tone) 55%, transparent), transparent 70%), #0b0f1a; }
    .ld-art img { width: 100%; height: 100%; object-fit: cover; }
    .ld-art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(7, 10, 18, 0.95) 0%, rgba(7, 10, 18, 0.72) 42%, rgba(7, 10, 18, 0.1) 100%), linear-gradient(0deg, rgba(7, 10, 18, 0.85), transparent 45%); }
    .ld-inst-copy { position: absolute; left: 6%; right: 8%; bottom: 9%; display: flex; flex-direction: column; gap: 1.2cqi; }
    .ld-studio { font-size: 1.9cqi; font-weight: 600; color: #c9d2ec; letter-spacing: 0.02em; }
    .ld-name { font-size: clamp(16px, 4.6cqi, 40px); font-weight: 800; line-height: 1.04; letter-spacing: -0.02em; max-width: 92%; text-wrap: balance; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .ld-meta { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-sans); font-size: 1.8cqi; color: #aab4cf; }
    .ld-action { position: relative; margin-top: 2cqi; height: 7.2cqi; min-height: 34px; }
    .ld-sync { position: absolute; inset: 0 auto 0 0; width: min(62%, 420px); display: grid; align-content: center; gap: 0.9cqi; opacity: 0; }
    .ld-sync-label { font-family: var(--font-sans); font-size: 1.7cqi; color: #c9d2ec; }
    .ld-bar { height: 0.9cqi; min-height: 5px; border-radius: 99px; background: rgba(255, 255, 255, 0.08); overflow: hidden; }
    .ld-bar i { display: block; height: 100%; width: 100%; border-radius: inherit; transform-origin: left; background: linear-gradient(90deg, #3c62d8, #8fb0ff); box-shadow: 0 0 14px rgba(91, 140, 255, 0.7); }
    .ld-sync-n { font-family: var(--font-mono); font-size: 1.5cqi; color: #8b97b8; }
    .ld-play {
        position: absolute; left: 0; top: 0; height: 100%;
        display: inline-flex; align-items: center; gap: 1.2cqi; padding-inline: 4.6cqi;
        border-radius: 99px; font-weight: 800; font-size: 2.5cqi; letter-spacing: -0.01em;
        background: linear-gradient(135deg, color-mix(in oklab, var(--tone) 100%, white 12%), color-mix(in oklab, var(--tone) 72%, black));
        box-shadow: 0 12px 32px -6px color-mix(in oklab, var(--tone) 70%, transparent), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    }
    .ld-play :global(svg) { width: 2.6cqi; height: 2.6cqi; min-width: 14px; min-height: 14px; }

    .ld-redeem { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(3, 5, 10, 0.62); backdrop-filter: blur(6px); opacity: 0; visibility: hidden; }
    .ld-card {
        width: min(74%, 440px); display: grid; justify-items: center; text-align: center; gap: 1.1cqi;
        padding: 4cqi 4cqi 3.6cqi; border-radius: 3cqi;
        background: rgba(14, 19, 31, 0.92); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 30px 64px rgba(0, 0, 0, 0.6);
    }
    .ld-card-ic { display: grid; place-items: center; width: 7.4cqi; height: 7.4cqi; border-radius: 2.2cqi; background: rgba(91, 140, 255, 0.14); box-shadow: inset 0 0 0 1px rgba(91, 140, 255, 0.35); color: #7aa2ff; margin-bottom: 0.6cqi; }
    .ld-card-ic :global(svg) { width: 3.4cqi; height: 3.4cqi; }
    .ld-card-t { font-size: 3cqi; font-weight: 700; }
    .ld-card-s { font-family: var(--font-sans); font-size: 1.75cqi; color: #9aa7c2; }
    .ld-label { justify-self: start; margin-top: 1.4cqi; font-family: var(--font-sans); font-size: 1.4cqi; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7691; }
    .ld-code {
        position: relative; width: 100%; display: flex; justify-content: center; align-items: center;
        padding: 1.8cqi 2cqi; border-radius: 1.8cqi; background: #0b0f1a;
        border: 1px solid #5b8cff; box-shadow: 0 0 0 0.6cqi rgba(91, 140, 255, 0.14);
        font-family: var(--font-mono); font-size: clamp(11px, 3cqi, 24px); font-weight: 500; letter-spacing: 0.2em; color: #f4f7fd;
    }
    .ld-code .dash { color: #4d566d; }
    .ld-caret { width: 2px; height: 1.2em; margin-left: 2px; background: #5b8cff; opacity: 0; }
    .ld-redeem-btn {
        width: 100%; margin-top: 1.4cqi; padding-block: 1.8cqi; border-radius: 1.8cqi;
        background: linear-gradient(135deg, #7aa2ff, #5b8cff); font-weight: 700; font-size: 2cqi;
        box-shadow: 0 6px 18px rgba(91, 140, 255, 0.45);
    }
    .ld-toast {
        position: absolute; right: 3%; bottom: 4%; display: inline-flex; align-items: center; gap: 8px;
        padding: 1.3cqi 2cqi; border-radius: 1.6cqi; font-family: var(--font-sans); font-size: 1.6cqi; font-weight: 500;
        background: rgba(14, 19, 31, 0.92); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 14px 30px rgba(0, 0, 0, 0.5);
        opacity: 0;
    }
    .ld-toast :global(svg) { color: #22c55e; width: 2.4cqi; height: 2.4cqi; min-width: 18px; min-height: 18px; padding: 3px; border-radius: 50%; background: rgba(34, 197, 94, 0.16); }

    /* Before the sequence: the redeem card is up and the code is empty. */
    .ld[data-state='pre'] .ld-redeem { opacity: 1; visibility: visible; }
    .ld[data-state='pre'] .ld-code > span { opacity: 0; }
    .ld[data-state='pre'] .ld-caret { opacity: 1; }
    .ld[data-state='pre'] [data-ld-tile] { opacity: 0; transform: scale(0.6); }
    .ld[data-state='pre'] .ld-play { opacity: 0; }

    @container (max-width: 520px) {
        .ld-rail { display: none; }
        .ld-studio, .ld-meta { font-size: 11px; }
        .ld-card-s, .ld-label { display: none; }
    }
</style>
