---
/*
 * The products themselves, as they are: real captures of Events Client,
 * the studio panel and Events Calendar, stacked like windows on a desk.
 * Nothing here is redrawn. The home script fans the layers in and lets the
 * pointer move them a little; without motion they simply sit in place.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import explore from '../assets/shots/explore.png';
import panel from '../assets/shots/panel.png';
import calendar from '../assets/shots/calendar.png';
---
<div class="hs" data-stack>
    <figure class="hs-layer hs-panel" data-depth="0.5">
        <div class="hs-bar" aria-hidden="true"><i></i><i></i><i></i><span>panel.eventsmc.xyz</span></div>
        <Image src={panel} alt="Panel de Events: instancias de un studio con su estado" widths={[640, 960, 1280]} sizes="(max-width: 980px) 70vw, 520px" loading="eager" />
        <figcaption class="hs-tag"><Icon name="panel" size={14} /> Panel</figcaption>
    </figure>
    <figure class="hs-layer hs-client" data-depth="1">
        <Image src={explore} alt="Events Client, sección Explorar con los próximos eventos de los studios" widths={[720, 1080, 1280]} sizes="(max-width: 980px) 88vw, 600px" loading="eager" fetchpriority="high" />
        <figcaption class="hs-tag"><Icon name="gamepad" size={14} /> Events Client</figcaption>
    </figure>
    <figure class="hs-layer hs-cal" data-depth="1.5">
        <div class="hs-bar" aria-hidden="true"><i></i><i></i><i></i><span>calendar.eventsmc.xyz</span></div>
        <Image src={calendar} alt="Events Calendar con los eventos de octubre" widths={[480, 720, 960]} sizes="(max-width: 980px) 46vw, 300px" loading="eager" />
        <figcaption class="hs-tag"><Icon name="calendar" size={14} /> Calendar</figcaption>
    </figure>
</div>

<style>
    .hs { position: relative; aspect-ratio: 1 / 0.82; perspective: 1600px; }
    .hs-layer {
        position: absolute; margin: 0; border-radius: 14px; overflow: visible;
        transform-style: preserve-3d; will-change: transform;
    }
    .hs-layer :global(img) {
        display: block; width: 100%; height: auto; border-radius: 0 0 14px 14px;
    }
    .hs-client :global(img) { border-radius: 12px; }
    .hs-layer::before {
        content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; z-index: 2;
        box-shadow: inset 0 0 0 1px rgba(190, 200, 255, 0.14);
    }
    .hs-panel { width: 84%; top: 0; right: -4%; box-shadow: var(--shadow-4); opacity: 0.92; }
    .hs-client {
        width: 86%; top: 22%; left: -2%; z-index: 2;
        box-shadow: 0 50px 100px -30px rgba(3, 2, 20, 0.95), 0 0 0 1px rgba(190, 200, 255, 0.16), 0 0 140px -40px rgba(107, 60, 255, 0.55);
    }
    .hs-cal { width: 40%; bottom: -8%; right: -3%; z-index: 3; box-shadow: 0 30px 70px -20px rgba(3, 2, 20, 0.95); }
    .hs-bar {
        display: flex; align-items: center; gap: 6px; height: 28px; padding-inline: 12px;
        border-radius: 14px 14px 0 0; background: #10142a; border-bottom: 1px solid rgba(190, 200, 255, 0.08);
        font-size: 11px; color: var(--text-3);
    }
    .hs-bar i { width: 8px; height: 8px; border-radius: 50%; background: rgba(255, 255, 255, 0.14); }
    .hs-bar span { margin-left: 8px; font-family: var(--font-mono); letter-spacing: 0.02em; }
    .hs-tag {
        position: absolute; z-index: 3; display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 10px; border-radius: 99px; font-size: 12px; font-weight: 600; color: var(--text);
        background: rgba(10, 12, 26, 0.9); backdrop-filter: blur(8px);
        box-shadow: 0 0 0 1px var(--border-strong), var(--shadow-2);
    }
    .hs-panel .hs-tag { top: -14px; right: 18px; }
    .hs-client .hs-tag { bottom: -14px; left: 18px; }
    .hs-cal .hs-tag { top: -14px; right: 14px; }
    @media (max-width: 980px) {
        .hs { aspect-ratio: 1 / 0.86; margin-top: 12px; }
    }
    @media (max-width: 560px) {
        .hs-tag { font-size: 11px; padding: 5px 8px; }
        .hs-bar { height: 20px; } .hs-bar span { display: none; }
    }
</style>
