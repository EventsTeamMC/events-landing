---
/*
 * The Events mark: a planet and its ring, one colour (currentColor).
 * Cropped to the drawing, so a 28px logo is 28px of planet, not of padding.
 */
interface Props { size?: number; class?: string; label?: string }
const { size = 28, class: cls, label } = Astro.props;
---
<svg
    class={cls}
    width={size}
    height={Math.round(size * 0.69)}
    viewBox="112 258 792 548"
    fill="currentColor"
    aria-hidden={label ? undefined : 'true'}
    role={label ? 'img' : undefined}
    aria-label={label}
    focusable="false"
