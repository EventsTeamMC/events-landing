---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Horizon from '../components/Horizon.astro';
import LauncherDemo from '../components/LauncherDemo.astro';
import { PRODUCTS, PLUS_PLANS, LINKS, PLUS_GIFT, eur } from '../data/site';
import { getDownloads, getUpcoming, eventWhen } from '../data/live';

const [downloads, upcoming] = await Promise.all([getDownloads(), getUpcoming()]);
const next = upcoming[0] ?? null;
const fmt = (n: number) => n.toLocaleString('es-ES');

const NIGHT = [
    { t: 'Una semana antes', icon: 'calendar', tone: 'var(--p-calendar)', product: 'Events Calendar', title: 'Lo publicas', text: 'El evento sale en Events Calendar y en Explorar, dentro del launcher de todos los jugadores.' },
    { t: 'Dos días antes', icon: 'list-checks', tone: 'var(--p-whitelist)', product: 'Events Whitelist', title: 'Se apuntan', text: 'Cada jugador escribe su nick en tu Discord. El bot comprueba la cuenta y lo añade a la whitelist.' },
    { t: 'La víspera', icon: 'download', tone: 'var(--p-client)', product: 'Events Client', title: 'Descargan antes', text: 'Con el código, la instancia se descarga antes de abrir. El día del evento nadie espera colas.' },
    { t: '22:00', icon: 'panel', tone: 'var(--p-client)', product: 'Panel', title: 'Abres', text: 'Un botón en el panel y todos pulsan Jugar a la vez, con los mismos archivos. Con Events+ 3, se abre sola a su hora.' },
    { t: 'Durante', icon: 'shield', tone: 'var(--p-blacklist)', product: 'Panel y Events Blacklist', title: 'Moderas', text: 'Ves quién está dentro y lo desconectas si hace falta. Si entra alguien baneado en otras comunidades, tu staff recibe un aviso.' },
    { t: 'Después', icon: 'chart', tone: 'var(--p-plus)', product: 'Events+', title: 'Lo mides', text: 'Pico de jugadores a la vez, descargas completadas y crashes por versión, con histórico.' },
];

const products = PRODUCTS.filter((p) => p.id !== 'plus');
---
<Base
    title="Events · El ecosistema para los eventos de Minecraft"
    description="Launcher, panel y bots para eventos de Minecraft. Tus jugadores entran con un código y la instancia se prepara sola."
    jsonld={[
        { '@context': 'https://schema.org', '@type': 'Organization', name: 'Events Team', alternateName: 'Events', url: 'https://www.eventsmc.xyz/', logo: 'https://www.eventsmc.xyz/icon.png', sameAs: [LINKS.discord] },
        { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Events', url: 'https://www.eventsmc.xyz/', inLanguage: 'es' },
    ]}
>
    <!-- ============================================================ hero -->
    <section class="hero">
        <div class="wrap hero-grid">
            <div class="hero-copy">
                <h1 class="h-display hero-h">
                    <span class="hl">Monta el evento.</span>
                    <span class="hl">Comparte el código.</span>
                    <span class="hl hl-3">A jugar.</span>
                </h1>
                <p class="lead hero-lead">
                    Events es el launcher, el panel y los bots para eventos de Minecraft. Tus jugadores entran con un código
                    y la instancia se prepara sola: versión, loader y mods.
                </p>
                <div class="hero-cta">
                    <a class="btn btn-primary btn-lg" href="/download"><Icon name="download" /> Descargar Events Client</a>
                    <a class="btn btn-secondary btn-lg" href="#lados">Organizo eventos <Icon name="arrow-right" class="arrow" /></a>
                </div>
                <p class="hero-meta small">
                    {downloads !== null && <><span class="tnum" data-dl-count>{fmt(downloads)}</span> descargas<span class="sep" aria-hidden="true"></span></>}
                    Windows, macOS y Linux<span class="sep" aria-hidden="true"></span>Gratis para jugadores
                </p>
            </div>
            <div class="hero-demo">
                <LauncherDemo event={next} />
                <button class="replay" type="button" data-ld-replay hidden><Icon name="refresh" size={15} /> Volver a verlo</button>
            </div>
        </div>
        <Horizon id="hz-hero" />
    </section>

    <!-- ============================================================ two sides -->
    <section class="section sides" id="lados">
        <div class="wrap">
            <div class="section-head" data-reveal>
                <h2 class="h2">Un evento tiene dos lados.<br /><span class="dim">El código los une.</span></h2>
            </div>

            <div class="sides-grid">
                <article class="side" data-reveal>
                    <h3 class="h3">Quien juega</h3>
                    <p class="side-lead">Descarga Events Client una vez. Para cada evento, un código.</p>
                    <ul role="list" class="side-list">
                        <li><Icon name="key" /><span>Entra con el código que le pasa el studio.</span></li>
                        <li><Icon name="layers" /><span>Versión, loader y mods se instalan solos: Vanilla, Forge, Fabric, NeoForge o Quilt.</span></li>
                        <li><Icon name="refresh" /><span>Solo descarga lo que cambia, verificado por hash. Sus ajustes y su VoiceChat se conservan.</span></li>
                        <li><Icon name="lock" /><span>Cuenta Microsoft u offline vinculada a Discord. Nunca paga nada.</span></li>
                    </ul>
                    <a class="go" href="/client">Conocer Events Client <Icon name="arrow-right" /></a>
                </article>

                <div class="sides-link" aria-hidden="true">
                    <span class="sides-line"></span>
                    <span class="sides-code code">K7QX-29PL-EV4M</span>
                    <span class="sides-line"></span>
                </div>

                <article class="side side-studio" data-reveal style="--i:1">
                    <h3 class="h3">Quien organiza</h3>
                    <p class="side-lead">Prepara la instancia en el panel y decide quién entra.</p>
                    <div class="mini-panel" aria-hidden="true">
                        <div class="mp-row mp-head"><span>Instancia</span><span>Código</span><span>Jugando</span><span>Estado</span></div>
                        <div class="mp-row"><span class="mp-name"><i style="--c:#ff7300"></i>Evento principal</span><span class="code mp-code">K7QX-···</span><span class="tnum">184</span><span class="status on">Abierta</span></div>
                        <div class="mp-row"><span class="mp-name"><i style="--c:#7b5cff"></i>Ensayo del staff</span><span class="code mp-code">R2D9-···</span><span class="tnum">6</span><span class="status soon">Whitelist</span></div>
                        <div class="mp-row"><span class="mp-name"><i style="--c:#38d2f0"></i>Próxima temporada</span><span class="code mp-code">—</span><span class="tnum">0</span><span class="status">Cerrada</span></div>
                    </div>
                    <ul role="list" class="side-list compact">
                        <li><Icon name="upload" /><span>Importa un .mrpack o sube los archivos con el editor.</span></li>
                        <li><Icon name="users" /><span>Códigos, whitelist y baneos por jugador o por IP.</span></li>
                        <li><Icon name="activity" /><span>Jugadores en directo, logo, fondos y colores propios.</span></li>
                    </ul>
                    <a class="go" href={LINKS.panel} target="_blank" rel="noopener">Abrir el panel <Icon name="arrow-up-right" /></a>
                </article>
            </div>
        </div>
    </section>

    <!-- ============================================================ the night -->
    <section class="section night" id="como">
        <div class="wrap night-grid">
            <div class="night-aside">
                <h2 class="h2" data-reveal>Así se vive un evento con Events.</h2>
                <div class="night-clock" aria-hidden="true">
                    {NIGHT.map((n, i) => (
                        <div class:list={['clock-face', { on: i === 0 }]} data-clock={i}>
                            <span class="clock-t">{n.t}</span>
                            <span class="clock-p"><span class="mark" style={`--tone:${n.tone}`}><Icon name={n.icon as any} /></span>{n.product}</span>
                        </div>
                    ))}
                </div>
            </div>
            <ol class="night-steps" role="list">
                {NIGHT.map((n, i) => (
                    <li class="step" data-step={i} data-reveal>
                        <span class="step-t">{n.t}</span>
                        <h3 class="h3">{n.title}</h3>
                        <p>{n.text}</p>
                        <span class="step-p"><span class="dot" style={`--tone:${n.tone}`}></span>{n.product}</span>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <!-- ============================================================ system -->
    <section class="section system" id="productos">
        <div class="wrap">
            <div class="section-head" data-reveal>
                <h2 class="h2">Cada pieza funciona sola.<br /><span class="dim">Juntas, montan el evento.</span></h2>
            </div>
            <ul role="list" class="sys">
                {products.map((p, i) => {
                    const inner = (
                        <>
                            <span class="mark" style={`--tone:${p.tone}`}><Icon name={p.icon as any} /></span>
                            <span class="sys-copy">
                                <span class="sys-name">{p.name} <span class="sys-kind">{p.kind}</span></span>
                                <span class="sys-line">{p.line}</span>
                            </span>
                            {p.status === 'soon'
                                ? <span class="status soon">Próximamente</span>
                                : <Icon name={p.external ? 'arrow-up-right' : 'arrow-right'} class="sys-go" />}
                        </>
                    );
                    return (
                        <li data-reveal style={`--i:${i % 2}`} class:list={['sys-row', { soon: p.status === 'soon' }]}>
                            {p.href
                                ? <a class="sys-link" href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>{inner}</a>
                                : <div class="sys-link">{inner}</div>}
                        </li>
                    );
                })}
            </ul>
        </div>
    </section>

    <!-- ============================================================ proof -->
    <section class="section-tight proof">
        <div class="wrap proof-grid">
            <div class="proof-lead" data-reveal>
                <h2 class="h2">Ya se juega con Events.</h2>
                {downloads !== null
                    ? <p class="proof-n"><span class="live-dot" aria-hidden="true"></span><span class="tnum" data-dl-count>{fmt(downloads)}</span> descargas de Events Client.</p>
                    : <p class="proof-n">Events Client funciona en Windows, macOS y Linux.</p>}
                <p class="muted">Blacklist guarda el servidor que reporta con un hash irreversible y no lee mensajes. <a href="/blacklist#privacidad">Cómo funciona</a></p>
            </div>
            <div class="proof-event" data-reveal style="--i:1">
                {next ? (
                    <a class="nev" href={LINKS.calendar} target="_blank" rel="noopener" style={next.color ? `--tone:${next.color}` : ''}>
                        <span class="nev-k">Próximo evento</span>
                        <span class="nev-name">{next.name}</span>
                        <span class="nev-meta">{next.studio}<span class="sep" aria-hidden="true"></span><span class="nev-when">{eventWhen(next.startsAt)}</span></span>
                        <span class="go">Ver el calendario <Icon name="arrow-up-right" /></span>
                    </a>
                ) : (
                    <a class="nev" href={LINKS.calendar} target="_blank" rel="noopener">
                        <span class="nev-name">Los eventos de todos los studios, en un calendario.</span>
                        <span class="go">Ver el calendario <Icon name="arrow-up-right" /></span>
                    </a>
                )}
                <a class="status-link" href={LINKS.status} target="_blank" rel="noopener"><span class="ft-dot" aria-hidden="true"></span>Estado del servicio</a>
            </div>
        </div>
    </section>

    <!-- ============================================================ events+ -->
    <section class="section plus">
        <div class="wrap plus-grid">
            <div data-reveal>
                <h2 class="h2">Events+, para quien organiza.</h2>
                <p class="lead" style="margin-top:16px">Más instancias vivas, sin tope de jugadores a la vez y cola prioritaria. Lo paga el studio; los jugadores no pagan nada.</p>
                <p class="plus-gift small"><Icon name="sparkle" size={16} /> {PLUS_GIFT}</p>
                <div class="plus-cta">
                    <a class="btn btn-secondary btn-lg" href="/plus">Ver los planes <Icon name="arrow-right" class="arrow" /></a>
                </div>
            </div>
            <ul role="list" class="plus-tiers" data-reveal style="--i:1">
                {PLUS_PLANS.map((p) => (
                    <li class:list={['tier', { pick: p.pick }]}>
                        <span class="tier-n">{p.instances}</span>
                        <span class="tier-copy">
                            <span class="tier-name">{p.name}</span>
                            <span class="tier-what">{p.instances === 1 ? '1 instancia' : `${p.instances} instancias`}</span>
                        </span>
                        <span class="tier-price tnum">{eur(p.monthly)}<small>/mes</small></span>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- ============================================================ close -->
    <section class="close">
        <div class="wrap close-inner" data-reveal>
            <h2 class="h1">Tu próximo evento<br />empieza con un código.</h2>
            <div class="hero-cta center">
                <a class="btn btn-primary btn-lg" href="/download"><Icon name="download" /> Descargar Events Client</a>
                <a class="btn btn-secondary btn-lg" href={LINKS.panel} target="_blank" rel="noopener">Abrir el panel</a>
                <a class="btn btn-ghost btn-lg" href={LINKS.discord} target="_blank" rel="noopener"><Icon name="discord" /> Discord</a>
            </div>
        </div>
        <Horizon id="hz-close" class="close-hz" />
    </section>
</Base>

<style>
    .dim { color: var(--text-3); }
    .sep { display: inline-block; width: 3px; height: 3px; border-radius: 50%; background: var(--text-3); margin: 0 10px; vertical-align: middle; }

    /* ---------------- hero */
    .hero { position: relative; padding-top: clamp(40px, 6vw, 88px); padding-bottom: clamp(160px, 22vw, 300px); overflow: clip; }
    .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
    .hero-copy { container-type: inline-size; }
    .hero-h { display: grid; gap: 0.02em; font-size: min(4.6rem, 9.4cqi); }
    .hl { white-space: nowrap; }
    .hl { display: block; }
    @media (max-width: 980px) { .hero-h { font-size: clamp(2.5rem, 11.5cqi, 4.4rem); } .hl { white-space: normal; } }
    .hl-3 { color: #b9a8ff; }
    .hero-lead { margin-top: 24px; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
    .hero-cta.center { justify-content: center; }
    @media (max-width: 520px) { .hero-cta .btn { width: 100%; } }
    .hero-meta { margin-top: 22px; color: var(--text-3); }
    .hero-meta .tnum { color: var(--text); font-weight: 600; }
    .hero-demo { position: relative; margin-right: calc(-1 * clamp(0px, 4vw, 64px)); }
    .replay {
        position: absolute; right: 8px; bottom: -44px; display: inline-flex; align-items: center; gap: 6px;
        height: 32px; padding-inline: 12px; border-radius: 99px; font-size: var(--fs-xs); font-weight: 600; color: var(--text-3);
        transition: color var(--t-fast) ease, background-color var(--t-fast) ease;
    }
    .replay:hover { color: var(--text); background: rgba(255, 255, 255, 0.05); }
    @media (max-width: 980px) {
        .hero-grid { grid-template-columns: 1fr; }
        .hero-demo { margin-right: 0; }
    }

    /* ---------------- sides */
    .sides { position: relative; }
    .sides-grid { display: grid; grid-template-columns: 1fr auto 1.15fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
    .side { display: grid; gap: 18px; align-content: start; }
    .side-lead { color: var(--text-2); font-size: 1.05rem; max-width: 40ch; }
    .side-list { display: grid; gap: 14px; margin-top: 6px; }
    .side-list li { display: grid; grid-template-columns: 22px 1fr; gap: 14px; align-items: start; }
    .side-list :global(svg) { color: var(--text-3); margin-top: 2px; }
    .side-list.compact { gap: 10px; }
    .side .go { margin-top: 8px; }
    .sides-link { display: grid; grid-template-rows: 1fr auto 1fr; justify-items: center; gap: 14px; align-self: stretch; padding-block: 8px; }
    .sides-line { width: 1px; background: linear-gradient(var(--border-strong), rgba(157, 140, 255, 0.5), var(--border-strong)); }
    .sides-code {
        writing-mode: vertical-rl; transform: rotate(180deg);
        padding: 14px 8px; border-radius: 12px; font-size: 0.8rem;
        background: var(--surface); box-shadow: inset 0 0 0 1px var(--border-strong);
    }
    .mini-panel {
        border-radius: var(--r-lg); padding: 6px; font-size: 0.84rem;
        background: linear-gradient(180deg, var(--surface), var(--bg-raised));
        box-shadow: 0 0 0 1px var(--border), var(--shadow-3);
    }
    .mp-row { display: grid; grid-template-columns: 1.6fr 1fr 0.7fr 0.9fr; gap: 10px; align-items: center; padding: 11px 12px; border-radius: 10px; color: var(--text-2); }
    .mp-row + .mp-row { border-top: 1px solid var(--border); }
    .mp-head { font-size: var(--fs-xs); color: var(--text-3); font-weight: 500; }
    .mp-name { display: inline-flex; align-items: center; gap: 10px; color: var(--text); font-weight: 600; min-width: 0; }
    .mp-name i { flex: none; width: 10px; height: 10px; border-radius: 3px; background: var(--c); box-shadow: 0 0 0 3px color-mix(in oklab, var(--c) 22%, transparent); }
    .mp-code { font-size: 0.78rem; letter-spacing: 0.08em; color: var(--text-2); }
    @media (max-width: 900px) {
        .sides-grid { grid-template-columns: 1fr; }
        .sides-link { grid-template-rows: none; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0; }
        .sides-line { width: auto; height: 1px; background: linear-gradient(90deg, var(--border-strong), rgba(157, 140, 255, 0.5), var(--border-strong)); }
        .sides-code { writing-mode: horizontal-tb; transform: none; padding: 8px 14px; }
    }
    @media (max-width: 520px) {
        .mp-row { grid-template-columns: 1.5fr 0.6fr 1fr; }
        .mp-row > :nth-child(2) { display: none; }
    }

    /* ---------------- night */
    .night { position: relative; }
    .night::before {
        content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
        background: radial-gradient(50% 60% at 15% 40%, rgba(35, 72, 255, 0.08), transparent 70%);
    }
    .night-grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); }
    .night-aside { position: sticky; top: calc(var(--header-h) + 40px); align-self: start; }
    .night-clock { position: relative; margin-top: clamp(40px, 6vw, 80px); height: 180px; }
    .clock-face {
        position: absolute; inset: 0; display: grid; align-content: start; gap: 18px;
        opacity: 0; transform: translateY(10px); filter: blur(3px);
        transition: opacity 360ms var(--ease-out), transform 360ms var(--ease-out), filter 360ms var(--ease-out);
    }
    .clock-face.on { opacity: 1; transform: none; filter: none; }
    .clock-t { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.6rem, 1.6rem + 3vw, 4.4rem); line-height: 1; letter-spacing: -0.035em; color: var(--text); font-variant-numeric: tabular-nums; }
    .clock-p { display: inline-flex; align-items: center; gap: 12px; color: var(--text-2); font-weight: 600; }
    .night-steps { position: relative; display: grid; gap: 0; padding-left: 32px; }
    .night-steps::before { content: ''; position: absolute; left: 5px; top: 10px; bottom: 10px; width: 1px; background: linear-gradient(var(--border-strong), rgba(157, 140, 255, 0.4) 50%, var(--border-strong)); }
    .step { position: relative; padding-block: clamp(28px, 4vw, 56px); display: grid; gap: 8px; }
    .step + .step { border-top: 1px solid var(--border); }
    .step::before {
        content: ''; position: absolute; left: -32px; top: calc(clamp(28px, 4vw, 56px) + 6px);
        width: 11px; height: 11px; border-radius: 50%; background: var(--bg); box-shadow: inset 0 0 0 1.5px var(--border-strong);
        transition: background-color var(--t-base) ease, box-shadow var(--t-base) ease;
    }
    .step.on::before { background: #b9a8ff; box-shadow: 0 0 0 4px rgba(157, 140, 255, 0.18), 0 0 18px rgba(157, 140, 255, 0.6); }
    .step-t { font-size: var(--fs-small); font-weight: 600; color: var(--text-3); font-variant-numeric: tabular-nums; }
    .step p { max-width: 52ch; }
    .step-p { display: inline-flex; align-items: center; gap: 8px; font-size: var(--fs-xs); color: var(--text-3); font-weight: 500; }
    .step-p .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--tone); }
    @media (max-width: 900px) {
        .night-grid { grid-template-columns: 1fr; }
        .night-aside { position: static; }
        .night-clock { display: none; }
    }
    @media (min-width: 901px) { .step-t { display: none; } }

    /* ---------------- system */
    .sys { display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(24px, 4vw, 56px); }
    .sys-row { border-top: 1px solid var(--border); }
    .sys-link {
        display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px;
        padding: 20px 4px; border-radius: 12px;
        transition: background-color var(--t-fast) ease;
    }
    a.sys-link:hover { background: rgba(255, 255, 255, 0.025); }
    .sys-copy { display: grid; gap: 3px; min-width: 0; }
    .sys-name { color: var(--text); font-weight: 600; }
    .sys-kind { color: var(--text-3); font-weight: 400; font-size: var(--fs-small); margin-left: 6px; }
    .sys-line { color: var(--text-3); font-size: 0.92rem; }
    :global(.sys-go) { color: var(--text-3); transition: transform var(--t-fast) var(--ease-out), color var(--t-fast) ease; }
    a.sys-link:hover :global(.sys-go) { color: var(--text); transform: translateX(3px); }
    .sys-row.soon .mark { filter: saturate(0.4); opacity: 0.75; }
    @media (max-width: 760px) { .sys { grid-template-columns: 1fr; } .sys-kind { display: block; margin: 2px 0 0; } }

    /* ---------------- proof */
    .proof-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; padding-block: clamp(32px, 5vw, 56px); border-block: 1px solid var(--border); }
    .proof-lead { display: grid; gap: 16px; }
    .proof-n { font-size: var(--fs-lead); color: var(--text-2); display: flex; align-items: center; flex-wrap: wrap; gap: 0 8px; }
    .proof-n .tnum { color: var(--text); font-weight: 700; font-family: var(--font-display); font-size: 1.5em; letter-spacing: -0.02em; }
    .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 4px var(--success-soft); }
    .proof-event { display: grid; gap: 14px; }
    .nev {
        --tone: var(--action);
        position: relative; display: grid; gap: 8px; padding: 24px 26px; border-radius: var(--r-lg); overflow: hidden;
        background: linear-gradient(135deg, color-mix(in oklab, var(--tone) 14%, var(--surface)), var(--surface) 60%);
        box-shadow: inset 0 0 0 1px var(--border-strong), var(--shadow-3);
        transition: transform var(--t-press) var(--ease-out), box-shadow var(--t-fast) ease;
    }
    .nev:hover { box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--tone) 50%, transparent), var(--shadow-3); }
