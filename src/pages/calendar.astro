---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Steps from '../components/Steps.astro';
import { product, LINKS } from '../data/site';
import { getUpcoming, eventWhen } from '../data/live';

const p = product('calendar');
const upcoming = (await getUpcoming()).slice(0, 4);
---
<Base
    title="Events Calendar · Todos los eventos de Minecraft en un calendario"
    description="Cada studio publica sus eventos y aquí aparecen todos juntos. Público, sin cuenta y sin registro."
>
    <div style={`--tone:${p.tone}`}>
        <PageHero product={p} title="Todo lo que pasa en Events," titleDim="en un calendario." lead="Cada studio publica sus torneos, series y eventos, y aquí aparecen todos juntos. Cualquiera puede ver qué hay y cuándo, sin cuenta.">
            <Fragment slot="actions">
                <a class="btn btn-primary btn-lg" href={LINKS.calendar}>Abrir el calendario <Icon name="arrow-up-right" /></a>
                <button class="btn btn-secondary btn-lg" type="button" data-access-open>Publicar mis eventos</button>
            </Fragment>
            <div slot="visual" class="agenda" aria-label="Próximos eventos">
                <p class="agenda-h">Próximos eventos</p>
                {upcoming.length ? (
                    <ul role="list">
                        {upcoming.map((e) => (
                            <li class="ag-row" style={e.color ? `--c:${e.color}` : ''}>
                                <span class="ag-bar" aria-hidden="true"></span>
                                <span class="ag-copy"><b>{e.name}</b><span>{e.studio}</span></span>
                                <span class="ag-when tnum">{eventWhen(e.startsAt)}</span>
                            </li>
                        ))}
                    </ul>
                ) : (
                    <p class="ag-empty">No hay eventos publicados esta semana. <a href={LINKS.calendar}>Ver el calendario</a></p>
                )}
            </div>
        </PageHero>

        <section class="section-tight" id="como">
            <div class="wrap">
                <div class="section-head" data-reveal><h2 class="h2">Cómo funciona.</h2></div>
                <Steps steps={[
                    { title: 'Un studio publica', text: 'Desde su panel elige fecha, hora, nombre y color. Si dura varios días, marca cuándo empieza y cuándo acaba.' },
                    { title: 'Aparece al momento', text: 'Sin revisión ni aprobación: cada studio es dueño de lo que publica y responsable de ello.' },
                    { title: 'La comunidad lo ve', text: 'Cualquiera puede abrir un evento y ver quién lo organiza, a qué hora empieza y por dónde entrar.' },
                ]} />
            </div>
        </section>

        <section class="section" id="studios">
            <div class="wrap studios">
                <div data-reveal>
                    <h2 class="h2">Tu evento, con tu nombre.</h2>
                    <p class="lead" style="margin-top:14px">Cada evento sale a nombre de tu studio, con tu logo y tu Discord.</p>
                </div>
                <ul role="list" class="studio-list" data-reveal style="--i:1">
                    <li><Icon name="image" size={18} /><span>Color propio para distinguirlo de un vistazo.</span></li>
                    <li><Icon name="calendar" size={18} /><span>Eventos de un día o series de varias jornadas.</span></li>
                    <li><Icon name="discord" size={18} /><span>Enlace directo a tu Discord, y al del evento si es otro.</span></li>
                    <li><Icon name="panel" size={18} /><span>Si ya usas el panel de Events, ya puedes publicar. Si solo quieres el calendario, hay cuentas que solo publican eventos.</span></li>
                </ul>
            </div>
        </section>

        <section class="section-tight">
            <div class="wrap end-row" data-reveal>
                <h2 class="h2">¿Vemos qué hay esta semana?</h2>
                <div class="end-actions">
                    <a class="btn btn-primary btn-lg" href={LINKS.calendar}>Abrir el calendario <Icon name="arrow-up-right" /></a>
                    <button class="btn btn-secondary btn-lg" type="button" data-access-open>Solicitar acceso</button>
                </div>
            </div>
        </section>
    </div>

    <dialog class="dlg" id="access" aria-labelledby="access-title">
        <form class="dlg-body" id="access-form" novalidate>
            <div class="dlg-head">
                <h2 class="h3" id="access-title">Publicar en el calendario</h2>
                <button class="dlg-close" type="button" aria-label="Cerrar" data-access-close><Icon name="x" /></button>
            </div>
            <p class="small muted">Las cuentas se aprueban a mano. Te escribimos por Discord.</p>
            <div class="access-fields">
                <div class="field"><label for="ac-discord">Tu usuario de Discord</label><input class="input" id="ac-discord" name="discord" maxlength="60" required autocomplete="username" aria-describedby="ac-discord-e" /><span class="error" id="ac-discord-e"></span></div>
                <div class="field"><label for="ac-studio">Nombre del studio</label><input class="input" id="ac-studio" name="studio" maxlength="80" required aria-describedby="ac-studio-e" /><span class="error" id="ac-studio-e"></span></div>
                <div class="field"><label for="ac-members">Miembros de la comunidad</label><input class="input" id="ac-members" name="members" type="number" min="1" max="100000000" inputmode="numeric" required aria-describedby="ac-members-e" /><span class="error" id="ac-members-e"></span></div>
                <div class="field"><label for="ac-invite">Invitación a vuestro Discord</label><input class="input" id="ac-invite" name="invite" maxlength="200" placeholder="https://discord.gg/…" required inputmode="url" aria-describedby="ac-invite-e" /><span class="error" id="ac-invite-e"></span></div>
                <div class="field"><label for="ac-note">Algo más <span class="muted">(opcional)</span></label><textarea class="input" id="ac-note" name="note" rows="3" maxlength="700"></textarea></div>
            </div>
            <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <p class="error" id="ac-error" role="alert"></p>
            <div class="access-actions">
                <button class="btn btn-ghost" type="button" data-access-close>Cancelar</button>
                <button class="btn btn-primary" type="submit">Enviar solicitud</button>
            </div>
        </form>
        <div class="dlg-body access-done" id="access-done" hidden>
            <span class="done-ic"><Icon name="check" size={22} /></span>
            <h2 class="h3">Solicitud enviada</h2>
            <p>La revisamos a mano y te escribimos por Discord.</p>
            <button class="btn btn-secondary" type="button" data-access-close>Cerrar</button>
        </div>
    </dialog>
</Base>

<style>
    .agenda {
        padding: 22px; border-radius: var(--r-xl); max-width: 520px; margin-inline: auto;
        background: rgba(13, 17, 34, 0.9); box-shadow: 0 0 0 1px var(--border-strong), var(--shadow-4), 0 0 100px -30px rgba(56, 210, 240, 0.3);
    }
    .agenda-h { font-size: var(--fs-small); font-weight: 600; color: var(--text-3); margin-bottom: 8px; }
    .ag-row { --c: var(--tone); display: grid; grid-template-columns: 4px 1fr auto; gap: 14px; align-items: center; padding: 14px 0; border-top: 1px solid var(--border); }
    .ag-bar { align-self: stretch; border-radius: 4px; background: var(--c); }
    .ag-copy { display: grid; min-width: 0; }
    .ag-copy b { color: var(--text); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ag-copy span { font-size: var(--fs-small); color: var(--text-3); }
    .ag-when { font-size: var(--fs-small); color: var(--text-2); white-space: nowrap; }
    .ag-empty { padding: 14px 0 4px; color: var(--text-2); border-top: 1px solid var(--border); }
    .studios { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
    .studio-list { display: grid; }
    .studio-list li { display: grid; grid-template-columns: 22px 1fr; gap: 14px; padding-block: 18px; border-top: 1px solid var(--border); }
    .studio-list :global(svg) { color: var(--tone); margin-top: 2px; }
    @media (max-width: 860px) { .studios { grid-template-columns: 1fr; } }
    .end-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
    .end-actions { display: flex; flex-wrap: wrap; gap: 12px; }
    .access-fields { display: grid; gap: 16px; margin-top: 20px; }
    .access-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; }
    .access-done { display: grid; justify-items: center; text-align: center; gap: 12px; }
    .access-done[hidden] { display: none; }
    .done-ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; color: var(--success); background: var(--success-soft); }
</style>

<script>
    const dlg = document.getElementById('access') as HTMLDialogElement;
    const form = document.getElementById('access-form') as HTMLFormElement;
    const done = document.getElementById('access-done')!;
    const general = document.getElementById('ac-error')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

    document.querySelectorAll('[data-access-open]').forEach((b) => b.addEventListener('click', () => {
        form.hidden = false; done.hidden = true; general.textContent = '';
        dlg.showModal();
    }));
    dlg.addEventListener('click', (e) => {
        if (e.target === dlg || (e.target as HTMLElement).closest('[data-access-close]')) dlg.close();
    });

    const fieldError = (name: string, msg: string) => {
        const input = form.elements.namedItem(name) as HTMLInputElement;
        const out = document.getElementById(`ac-${name}-e`);
        if (out) out.textContent = msg;
        if (msg) input.setAttribute('aria-invalid', 'true'); else input.removeAttribute('aria-invalid');
        return !msg;
    };

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const v = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement).value || '').trim();
        const ok = [
            fieldError('discord', v('discord').length < 2 ? 'Escribe tu usuario de Discord.' : ''),
            fieldError('studio', v('studio').length < 2 ? 'Escribe el nombre del studio.' : ''),
            fieldError('members', Number(v('members')) >= 1 ? '' : 'Indica cuántos miembros tiene la comunidad.'),
            fieldError('invite', /discord(app)?\.(gg|com)\//i.test(v('invite')) ? '' : 'Tiene que ser una invitación de Discord (https://discord.gg/…).'),
        ];
        if (ok.includes(false)) { form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus(); return; }
        submit.disabled = true; general.textContent = '';
        try {
            const r = await fetch('/api/access-request', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ discord: v('discord'), studio: v('studio'), members: v('members'), invite: v('invite'), note: v('note'), website: v('website') }),
            });
            const j = await r.json().catch(() => null);
            if (!r.ok) throw new Error(j?.error || 'No se pudo enviar. Vuelve a intentarlo.');
            form.reset(); form.hidden = true; done.hidden = false;
            done.querySelector<HTMLElement>('button')?.focus();
        } catch (x) {
            general.textContent = x instanceof TypeError ? 'Sin conexión. Revisa tu red.' : (x as Error).message;
        } finally { submit.disabled = false; }
    });
</script>
